%COMPILER            mpif90
%LINK                mpif90
%AR                  ar
%MAKE                gmake
%FPP_FLAGS	     -P -traditional
%FPP_DEF             CPP_FLUSH
%BASE_FFLAGS         -march=znver1 -fdefault-real-8 -fdefault-double-8 -fallow-argument-mismatch -ffree-line-length-0
%PROD_FFLAGS         -O3
%DEV_FFLAGS          
%DEBUG_FFLAGS        -g3 -Wall -fbounds-check -ffpe-trap=invalid,zero,overflow -O0 -fstack-protector-all -fbacktrace -finit-real=snan
%MPI_FFLAGS
%OMP_FFLAGS          -fopenmp
%BASE_LD             
%MPI_LD
%OMP_LD              -fopenmp
