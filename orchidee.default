# REFINEBOTTOM (-) :  Depth at which the hydrology layers will be refined towards the bottom. 	{}
REFINEBOTTOM =  .FALSE. 

# DEPTH_GEOM (m) :  Depth at which we resume geometrical increases for temperature 	{}
